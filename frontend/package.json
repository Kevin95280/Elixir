{
  "name": "cave_a_vin_frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "tailwind:build": "npx tailwindcss -i ./src/assets/css/tailwind.input.css -o ./src/assets/css/styleV2.css --content \"./src/**/*.{js,jsx}\" \"./index.html\" --watch",
    "tailwind:watch": "nodemon --watch src/assets/css/tailwind.input.css --exec \"npm run tailwind:build\"",
    "start": "parcel index.html",
    "build": "parcel build index.html",
    "translate": "node src/i18n/translate.js",
    "i18n:extract": "i18next src/**/*.{js,jsx}"
  },
  "staticFiles": {
    "staticPath": "public"
  },
  "dependencies": {
    "boring-avatars": "^2.0.4",
    "deepl-node": "^1.24.0",
    "dotenv": "^17.2.3",
    "i18next": "^25.7.4",
    "lucide-react": "^0.562.0",
    "parcel": "^2.16.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.5.3",
    "react-router-dom": "^6.30.3"
  },
  "devDependencies": {
    "i18next-parser": "^9.3.0",
    "nodemon": "^3.1.11",
    "tailwindcss-cli": "^0.1.2"
  }
}

